# Optional. Used for session HMAC and demo password digests (≥32 characters).
# If unset, the app falls back to the built-in demo pepper so Vercel/local work
# without configuring env. Seed hashes match the value below.
# If you change AUTH_SECRET, regenerate digests / seed hashes to match.
# AUTH_SECRET=dev-only-guestcare-auth-secret-min-32-chars!!

# Optional override for the admin demo user's plaintext password (hashed at verify time
# only when regenerating seed hashes — login still uses digests in agent store).
# AUTH_DEV_PASSWORD=admin
