# Required for session HMAC and demo password digests (≥32 characters).
# Seed agent password hashes were generated with the value below.
# If you change AUTH_SECRET, regenerate digests in src/features/auth/lib/password.ts
# or reset seed hashes to match.
AUTH_SECRET=dev-only-guestcare-auth-secret-min-32-chars!!

# Optional override for the admin demo user's plaintext password (hashed at verify time
# only when regenerating seed hashes — login still uses digests in agent store).
# AUTH_DEV_PASSWORD=admin
